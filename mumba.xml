<?xml version="1.0" encoding="UTF-8"?>
<!--
  mumba (Motorola Moto G57 Power / G100s): LineageOS 23.2, kernel built from source.
  Use this as a local_manifest on top of the official LineageOS manifest.
  Copy this file to .repo/local_manifests/mumba.xml

  Source projects and patched LineageOS projects are mirrored/forked under
  github.com/fiftydinar. Revisions are pinned to exact source commits.
-->
