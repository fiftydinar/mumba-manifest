+EXTRA_CFLAGS += -DCONFIG_INPUT_MISC_FPC1020_SAVE_TO_CLASS_DEVICE
 
 fpc1020_mmi-y += fpc1020_tee.o
 
 obj-m += fpc1020_mmi.o
