diff --git a/power_ext/PowerModeExtension.cpp b/power_ext/PowerModeExtension.cpp
new file mode 100644
index 0000000..6e5100f
--- /dev/null
+++ b/power_ext/PowerModeExtension.cpp
@@ -0,0 +1,76 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <aidl/android/hardware/power/BnPower.h>
+#include <android-base/file.h>
+#include <android-base/logging.h>
+
+namespace aidl {
+namespace google {
+namespace hardware {
+namespace power {
+namespace impl {
+namespace pixel {
+
+using ::aidl::android::hardware::power::Mode;
+
+// Motorola mumba: the chipone touch controller exposes gesture control through
+// /sys/class/touchscreen/<panel-name>/gesture ("ICNL9922C"/"primary" on this
+// device); value 49 enables the double-tap gesture bit, 48 disables it.
+// The driver additionally needs "gesture wakeup" enabled (gesture_en \(Y\)),
+// otherwise it suspends into "sleep" instead of "gesture" and never wakes up.
+static constexpr const char* kGestureNodes[] = {
+        "/sys/class/touchscreen/primary/gesture",
+        "/sys/class/touchscreen/ICNL9922C/gesture",
+};
+static constexpr const char* kGestureEnNodes[] = {
+        "/sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a8c000.spi/spi_master/spi1/spi1.0/misc/gesture_en",
+};
+static constexpr const char kDt2wOn[] = "49";
+static constexpr const char kDt2wOff[] = "48";
+static constexpr const char kDt2wEnOn[] = "Y";
+static constexpr const char kDt2wEnOff[] = "N";
+
+bool isDeviceSpecificModeSupported(Mode type, bool* _aidl_return) {
+    switch (type) {
+        case Mode::DOUBLE_TAP_TO_WAKE:
+            *_aidl_return = true;
+            return true;
+        default:
+            return false;
+    }
+}
+
+bool setDeviceSpecificMode(Mode type, bool enabled) {
+    switch (type) {
+        case Mode::DOUBLE_TAP_TO_WAKE: {
+            bool ok = false;
+            for (const char* node : kGestureNodes) {
+                if (!::android::base::WriteStringToFile(enabled ? kDt2wOn : kDt2wOff, node)) {
+                    LOG(ERROR) << "Failed to write " << node;
+                } else {
+                    ok = true;
+                }
+            }
+            for (const char* node : kGestureEnNodes) {
+                if (!::android::base::WriteStringToFile(enabled ? kDt2wEnOn : kDt2wEnOff, node)) {
+                    LOG(ERROR) << "Failed to write " << node;
+                } else {
+                    ok = true;
+                }
+            }
+            return ok;
+        }
+        default:
+            return false;
+    }
+}
+
+}  // namespace pixel
+}  // namespace impl
+}  // namespace power
+}  // namespace hardware
+}  // namespace google
+}  // namespace aidl
