diff --git a/fakestore/README.md b/fakestore/README.md
deleted file mode 100644
index 8efc914..0000000
--- a/fakestore/README.md
+++ /dev/null
@@ -1,16 +0,0 @@
-# microG FakeStore
-
-This is the upstream microG FakeStore v0.2.1 package (`com.android.vending`),
-included as a small compatibility stub. It does not provide Google Play Services
-or a functioning Play Store.
-
-- Upstream: https://github.com/microg/FakeStore/releases/tag/v0.2.1
-- APK: `com.android.vending-83700037.apk`
-- SHA-256: `ab3e5396956a80a1a3ebc7c1953da008d69f694f133bdd0cbc95e0e8e19ecda0`
-- License: Apache-2.0
-
-The device framework maps this package's declared fake signature to the
-allowlisted Google certificate in every build variant. The mapping remains
-restricted to the upstream microG signing certificate, the `com.android.vending`
-and `com.google.android.gms` package names, and the one certificate embedded in
-the framework; the APK must therefore remain presigned.
diff --git a/lineage_mumba_gapps.mk b/lineage_mumba_gapps.mk
new file mode 100644
index 0000000..c9da8c2
--- /dev/null
+++ b/lineage_mumba_gapps.mk
@@ -0,0 +1,41 @@
+#
+# SPDX-FileCopyrightText: The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+#
+
+# GApps variant of mumba. Same as lineage_mumba.mk, plus the Google apps staged
+# in vendor/partner_gms by tools/fetch_mindthegapps.py (run before building).
+# Keep this in sync with lineage_mumba.mk.
+
+# Inherit from those products. Most specific first.
+$(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit_only.mk)
+$(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)
+
+# Inherit from mumba device
+$(call inherit-product, device/motorola/mumba/device.mk)
+
+# Inherit some common Lineage stuff.
+$(call inherit-product, vendor/lineage/config/common_full_phone.mk)
+
+# Google apps from vendor/partner_gms (see vendor/lineage/config/partner_gms.mk).
+WITH_GMS := true
+GMS_MAKEFILE := gms_minimal.mk
+
+PRODUCT_NAME := lineage_mumba_gapps
+PRODUCT_DEVICE := mumba
+PRODUCT_MANUFACTURER := motorola
+PRODUCT_BRAND := Motorola
+PRODUCT_MODEL := G57 Power
+
+# Separate updater feed so GApps and vanilla installs never receive each other's OTAs.
+PRODUCT_PRODUCT_PROPERTIES += lineage.updater.uri=https://raw.githubusercontent.com/fiftydinar/mumba-manifest/main/ota/updates-gapps.json
+
+PRODUCT_GMS_CLIENTID_BASE := android-motorola
+
+PRODUCT_BUILD_PROP_OVERRIDES += \
+    BuildDesc="mumba_g-user 16 W1WAAS36.48-12-23-9 83f8c test-keys" \
+    BuildFingerprint=motorola/mumba_g/mumba:16/W1WAAS36.48-12-23-9/83f8c:user/test-keys \
+    DeviceName=mumba_g \
+    DeviceProduct=mumba_g \
+    SystemDevice=mumba \
+    SystemName=mumba

diff --git a/device.mk b/device.mk
index f5ae720..e118e99 100644
--- a/device.mk
+++ b/device.mk
@@ -154,8 +154,13 @@ PRODUCT_COPY_FILES += \
 
