+package com.android.settings.display;
+
+import android.content.Context;
+import android.hardware.display.DisplayManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.Display;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settingslib.core.lifecycle.LifecycleObserver;
+import com.android.settingslib.core.lifecycle.events.OnStart;
+import com.android.settingslib.core.lifecycle.events.OnStop;
+
+/** User-facing selector for the built-in display's native and sRGB color modes. */
+public class DisplayColorModePreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener, DisplayManager.DisplayListener,
+        LifecycleObserver, OnStart, OnStop {
+
+    private final DisplayManager mDisplayManager;
+    private ListPreference mPreference;
+
+    public DisplayColorModePreferenceController(Context context, String key) {
+        super(context, key);
+        mDisplayManager = context.getSystemService(DisplayManager.class);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        final Display display = getDefaultDisplay();
+        return supportsColorMode(display, Display.COLOR_MODE_DEFAULT)
+                        && supportsColorMode(display, Display.COLOR_MODE_SRGB)
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreference = screen.findPreference(getPreferenceKey());
+        if (mPreference != null) {
+            mPreference.setOnPreferenceChangeListener(this);
+            updateState(mPreference);
+        }
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        final Display display = getDefaultDisplay();
+        if (display == null || !(preference instanceof ListPreference)) {
+            return;
+        }
+
+        final int colorMode = display.getColorMode();
+        final ListPreference listPreference = (ListPreference) preference;
+        listPreference.setValue(Integer.toString(colorMode));
+        listPreference.setSummary(colorMode == Display.COLOR_MODE_SRGB
+                ? R.string.display_color_mode_srgb : R.string.display_color_mode_native);
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (!(newValue instanceof String)) {
+            return false;
+        }
+        final int colorMode;
+        try {
+            colorMode = Integer.parseInt((String) newValue);
+        } catch (NumberFormatException e) {
+            return false;
+        }
+        if (colorMode != Display.COLOR_MODE_DEFAULT && colorMode != Display.COLOR_MODE_SRGB) {
+            return false;
+        }
+
+        final Display display = getDefaultDisplay();
+        if (!supportsColorMode(display, colorMode)) {
+            return false;
+        }
+        display.requestColorMode(colorMode);
+        return true;
+    }
+
+    @Override
+    public void onStart() {
+        mDisplayManager.registerDisplayListener(this, new Handler(Looper.getMainLooper()));
+    }
+
+    @Override
+    public void onStop() {
+        mDisplayManager.unregisterDisplayListener(this);
+    }
+
+    @Override
+    public void onDisplayAdded(int displayId) {
+        updatePreference(displayId);
+    }
+
+    @Override
+    public void onDisplayChanged(int displayId) {
+        updatePreference(displayId);
+    }
+
+    @Override
+    public void onDisplayRemoved(int displayId) {
+        updatePreference(displayId);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_display;
+    }
+
+    private Display getDefaultDisplay() {
+        return mDisplayManager.getDisplay(Display.DEFAULT_DISPLAY);
+    }
+
+    private void updatePreference(int displayId) {
+        if (displayId == Display.DEFAULT_DISPLAY && mPreference != null) {
+            updateState(mPreference);
+        }
+    }
+
+    private static boolean supportsColorMode(Display display, int colorMode) {
+        if (display == null) {
+            return false;
+        }
+        for (int supportedColorMode : display.getSupportedColorModes()) {
+            if (supportedColorMode == colorMode) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
