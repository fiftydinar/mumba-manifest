diff --git a/config/BoardConfigKernel.mk b/config/BoardConfigKernel.mk
index 3d9fc0c6..ff410b05 100644
--- a/config/BoardConfigKernel.mk
+++ b/config/BoardConfigKernel.mk
@@ -292,11 +292,14 @@ KERNEL_MAKE_FLAGS += PAHOLE=$(BUILD_TOP)/prebuilts/kernel-build-tools/linux-x86/
 # Rust bindgen wants matching Clang and libclang versions
 KERNEL_MAKE_FLAGS += LIBCLANG_PATH=$(TARGET_KERNEL_CLANG_PATH)/lib
 
-# Set the out dir for the kernel's O= arg
-# This needs to be an absolute path, so only set this if the standard out dir isn't used
+# Set the out dir for the kernel's O= arg.
+# O= is passed to `make -C $(KERNEL_SRC)`, so a relative OUT_DIR would be resolved
+# against the kernel directory and the generated headers would land in the wrong
+# place. Prefix with $(BUILD_TOP)/ whenever OUT_DIR is relative (e.g. out,
+# out-vanilla, out-gapps); an absolute OUT_DIR needs no prefix.
 OUT_DIR_PREFIX := $(shell echo $(OUT_DIR) | sed -e 's|/target/.*$$||g')
 KERNEL_BUILD_OUT_PREFIX :=
-ifeq ($(OUT_DIR_PREFIX),out)
+ifeq ($(filter /%,$(OUT_DIR_PREFIX)),)
     KERNEL_BUILD_OUT_PREFIX := $(BUILD_TOP)/
 endif
 
