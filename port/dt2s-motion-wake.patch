+    // mumba: the touch panel keeps reporting the double-tap that triggered
+    // double-tap-to-sleep (and any finger still resting on the screen) as a motion
+    // or gesture event right as the device goes to sleep. Those residual events
+    // would otherwise immediately wake the device again, so the screen would never
+    // stay off. Ignore wakes for a short grace period after the device starts going
+    // to sleep. This is keyed off the recorded sleep time rather than
+    // mDeviceGoingToSleep, which is only set a few milliseconds later and would miss
+    // the event that races the sleep transition. Power and volume keys are handled
+    // separately and are not affected.
+    private static final long WAKE_AFTER_SLEEP_GRACE_MS = 500;
+
+    private boolean isWakeSuppressedAfterSleep(long eventTime) {
+        if (mDeviceGoingToSleep) {
+            return true;
+        }
+        final PowerManager.SleepData sleepData = mPowerManagerInternal.getLastGoToSleep();
+        if (sleepData == null) {
+            return false;
+        }
+        final long delta = eventTime - sleepData.goToSleepUptimeMillis;
+        return delta >= 0 && delta < WAKE_AFTER_SLEEP_GRACE_MS;
+    }
+
